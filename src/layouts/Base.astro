---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonicalURL?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description = 'A site about hidden structure — in systems, ideas, tools, and life.',
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  type = 'website',
} = Astro.props;

const fullTitle = title === 'potpuoy' ? 'potpuoy' : `${title} — potpuoy`;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="potpuoy" href="/rss.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <div class="container">
      <nav class="site-nav" aria-label="Site navigation">
        <a href="/" class="site-nav__name">potpuoy</a>
        <ul class="site-nav__links" role="list">
          <li><a href="/writing" aria-current={currentPath.startsWith('/writing') ? 'page' : undefined}>Writing</a></li>
          <li><a href="/about" aria-current={currentPath === '/about' ? 'page' : undefined}>About</a></li>
        </ul>
      </nav>
    </div>

    <main class="container page-main" id="main-content">
      <slot />
    </main>

    <footer class="container site-footer">
      <div class="site-footer__inner">
        <span class="site-footer__copy">© {new Date().getFullYear()} potpuoy</span>
        <a class="site-footer__rss" href="/rss.xml" aria-label="RSS feed">
          RSS
        </a>
      </div>
    </footer>
  </body>
</html>
