---
layout: base.njk
---
<article>
  <header class="post-header">
    <h1>{{ title }}</h1>
    <p class="meta">
      <time datetime="{{ date | machineDate }}">{{ date | humanDate }}</time>
      {% if type %}<span class="type">{{ type }}</span>{% endif %}
    </p>
    {% if summary %}<p class="summary">{{ summary }}</p>{% endif %}
    {% if tags and tags.length %}
      <p class="tags">
        {% for tag in tags %}<a href="/writing/?tag={{ tag }}">#{{ tag }}</a>{% if not loop.last %} {% endif %}{% endfor %}
      </p>
    {% endif %}
  </header>

  <section class="prose">
    {{ content | safe }}
  </section>
</article>

{# Neighbours within the same type — after a mechanism you most likely want
   another mechanism, not whatever happened to be published the day before.
   Falls back to publication order when a post is the only one of its type. #}
{% set sameType = collections.posts | filterByType(type) %}
{% set near = sameType | neighbours(page.url) %}
{% set scoped = true %}
{% if not near.prev and not near.next %}
  {% set near = collections.posts | neighbours(page.url) %}
  {% set scoped = false %}
{% endif %}

<footer class="post-footer">
  {% if near.prev or near.next %}
  <nav class="post-nav" aria-label="{% if scoped %}More {{ type }} posts{% else %}Post navigation{% endif %}">
    {% if near.prev %}
      <a href="{{ near.prev.url }}" class="post-nav-prev"><span aria-hidden="true">← </span>{{ near.prev.data.title }}</a>
    {% endif %}
    {% if near.next %}
      <a href="{{ near.next.url }}" class="post-nav-next">{{ near.next.data.title }}<span aria-hidden="true"> →</span></a>
    {% endif %}
  </nav>
  {% endif %}
  <p class="post-nav-meta">
    <a href="/feed.xml">RSS</a>
    <span class="sep" aria-hidden="true"> · </span>
    <a href="/writing/">All posts</a>
    <span class="sep" aria-hidden="true"> · </span>
    <a href="/">potpuoy.com</a>
  </p>
</footer>
