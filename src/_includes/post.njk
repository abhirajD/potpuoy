---
layout: base.njk
---
<article>
  <header class="post-header">
    <h1>{{ title }}</h1>
    <p class="meta">
      <time datetime="{{ date | machineDate }}">{{ date | humanDate }}</time>
      {% if type %}<span class="type">{{ type }}</span>{% endif %}
    </p>
    {% if summary %}<p class="summary">{{ summary }}</p>{% endif %}
    {% if tags and tags.length %}
      <p class="tags">
        {% for tag in tags %}<a href="/writing/?tag={{ tag }}">#{{ tag }}</a>{% if not loop.last %} {% endif %}{% endfor %}
      </p>
    {% endif %}
  </header>

  <section class="prose">
    {{ content | safe }}
  </section>
</article>

{% set prevPost = null %}
{% set nextPost = null %}
{% for post in collections.posts %}
  {% if post.url == page.url %}
    {% if not loop.last %}
      {% set prevPost = collections.posts[loop.index0 + 1] %}
    {% endif %}
    {% if loop.index0 > 0 %}
      {% set nextPost = collections.posts[loop.index0 - 1] %}
    {% endif %}
  {% endif %}
{% endfor %}

<footer class="post-footer">
  {% if prevPost or nextPost %}
  <nav class="post-nav" aria-label="Post navigation">
    {% if prevPost %}
      <a href="{{ prevPost.url }}" class="post-nav-prev"><span aria-hidden="true">← </span>{{ prevPost.data.title }}</a>
    {% endif %}
    {% if nextPost %}
      <a href="{{ nextPost.url }}" class="post-nav-next">{{ nextPost.data.title }}<span aria-hidden="true"> →</span></a>
    {% endif %}
  </nav>
  {% endif %}
  <p class="post-nav-meta">
    <a href="/feed.xml">RSS</a>
    <span class="sep" aria-hidden="true"> · </span>
    <a href="/writing/">All posts</a>
    <span class="sep" aria-hidden="true"> · </span>
    <a href="/">potpuoy.com</a>
  </p>
</footer>
